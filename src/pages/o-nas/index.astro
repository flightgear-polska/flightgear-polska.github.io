---
import Layout from '../../layouts/Layout.astro';

const siteUrl = 'https://flightgear-polska.github.io';

const timeline = [
  {
    rok: '2020',
    wydarzenie: 'Powstanie FlightGear Polska (31 sierpnia) – pierwsi piloci zakładają wspólny Discord i zaczynają latać razem nad Polską.',
  },
  {
    rok: '2023',
    wydarzenie: 'Start prac nad sceneriami polskich lotnisk i pierwszą wersją modelu PZL Koliber 150.',
  },
  {
    rok: '2024',
    wydarzenie: 'Czwarta rocznica FGPL – dwudniowy Airshow społeczności transmitowany na YouTube.',
  },
  {
    rok: 'Dziś',
    wydarzenie: 'Rozbudowa bazy polskich lotnisk i własnych poradników na tym portalu.',
  },
];
---
<Layout
  title="O nas | FlightGear Polska"
  description="Poznaj zespół FlightGear Polska – społeczność pasjonatów darmowego symulatora lotu, twórców polskich scenerii i modelu PZL Koliber 150."
>
  <main class="container mx-auto px-6 py-20 max-w-4xl">
    <nav aria-label="Okruszki" class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-brand-400 transition-colors">Strona główna</a> / <span class="text-gray-300">O nas</span>
    </nav>

    <h1 class="text-5xl font-heading font-black text-white mb-8">Kim <span class="text-brand-500">jesteśmy</span></h1>

    <p class="text-xl text-gray-400 leading-relaxed mb-6">
      FlightGear Polska (FGPL) to nieformalna, otwarta społeczność polskich pasjonatów lotnictwa wirtualnego, zorganizowana wokół darmowego, open-source'owego symulatora lotu FlightGear. Nie jesteśmy firmą ani wydawcą gier – jesteśmy grupą ludzi, którzy lubią latać, kodować i dzielić się tym, czego się nauczyli.
    </p>
    <p class="text-gray-400 leading-relaxed mb-12">
      Działamy całkowicie non-profit. Nasze projekty – sceneria polskich lotnisk, model PZL Koliber 150 czy poradniki na tym portalu – powstają w wolnym czasie i są publikowane na otwartych licencjach, zgodnie z duchem samego FlightGeara.
    </p>

    <h2 class="text-2xl font-bold text-white mb-6 border-l-4 border-brand-500 pl-4">Czym się zajmujemy</h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-16">
      <div>
        <h3 class="text-lg font-bold text-white mb-2">Rozwój scenerii i samolotów</h3>
        <p class="text-gray-400 text-sm leading-relaxed">Tworzymy i utrzymujemy polskie sceneria lotnisk oraz model PZL Koliber 150, dostępny w naszym <a href="https://github.com/flightgear-polska" target="_blank" rel="noopener noreferrer" class="text-brand-400 hover:text-brand-300 underline">repozytorium GitHub</a>.</p>
      </div>
      <div>
        <h3 class="text-lg font-bold text-white mb-2">Wspólne loty i pokazy</h3>
        <p class="text-gray-400 text-sm leading-relaxed">Organizujemy regularne loty grupowe oraz doroczny Airshow, transmitowany na żywo na naszym <a href="https://www.youtube.com/@FlightGearPL" target="_blank" rel="noopener noreferrer" class="text-brand-400 hover:text-brand-300 underline">kanale YouTube</a>.</p>
      </div>
      <div>
        <h3 class="text-lg font-bold text-white mb-2">Edukacja i wsparcie</h3>
        <p class="text-gray-400 text-sm leading-relaxed">Piszemy <a href="/poradniki/" class="text-brand-400 hover:text-brand-300 underline">poradniki</a> dla początkujących pilotów i pomagamy rozwiązywać problemy techniczne na naszym Discordzie.</p>
      </div>
      <div>
        <h3 class="text-lg font-bold text-white mb-2">Virtual Airlines i sieci ATC</h3>
        <p class="text-gray-400 text-sm leading-relaxed">Część naszej ekipy lata też w barwach wirtualnych linii (m.in. Parrott Airlines, Performance Airlines) oraz działa jako piloci i kontrolerzy na sieciach VATSIM i IVAO.</p>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-white mb-6 border-l-4 border-brand-500 pl-4">Nasza historia w skrócie</h2>
    <div class="space-y-6 mb-16">
      {timeline.map(item => (
        <div class="flex gap-6">
          <span class="font-mono text-brand-500 font-bold text-lg shrink-0 w-16">{item.rok}</span>
          <p class="text-gray-400 leading-relaxed">{item.wydarzenie}</p>
        </div>
      ))}
    </div>

    <div class="bg-dark-800 border border-white/10 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-white mb-3">Chcesz dołączyć?</h2>
      <p class="text-gray-400 mb-6">Niezależnie od tego, czy dopiero zaczynasz, czy latasz od lat – każdy znajdzie u nas miejsce.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="https://discord.gg/5J7uVYRhZV" target="_blank" rel="noopener noreferrer" class="inline-block bg-brand-500 hover:bg-brand-600 text-dark-950 font-black uppercase tracking-widest px-8 py-3 rounded-lg transition-colors">Dołącz do Discorda</a>
        <a href="https://github.com/flightgear-polska" target="_blank" rel="noopener noreferrer" class="inline-block border border-gray-700 hover:border-brand-400 hover:text-brand-400 text-white font-bold uppercase tracking-widest px-8 py-3 rounded-lg transition-colors">Zobacz GitHub</a>
      </div>
    </div>
  </main>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'O nas | FlightGear Polska',
    url: `${siteUrl}/o-nas/`,
    mainEntity: { '@type': 'Organization', name: 'FlightGear Polska', alternateName: 'FGPL' },
  })} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Strona główna', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'O nas', item: `${siteUrl}/o-nas/` },
    ],
  })} />
</Layout>
