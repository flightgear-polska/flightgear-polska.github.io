---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const wpisy = (await getCollection('poradniki')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---
<Layout
  title="Poradniki FlightGear | Optymalizacja FPS, Sprzęt, Pierwszy Lot"
  description="Własne poradniki FGPL dla pilotów FlightGear: procedura Cold & Dark dla początkujących, optymalizacja wydajności renderera oraz konfiguracja joysticka i HOTAS."
>
  <main class="container mx-auto px-6 py-20 max-w-4xl">
    <nav aria-label="Okruszki" class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-brand-400 transition-colors">Strona główna</a> / <span class="text-gray-300">Poradniki</span>
    </nav>
    <h1 class="text-5xl font-heading font-black text-white mb-8">Rozwiązywanie <span class="text-brand-500">Problemów</span></h1>
    <p class="text-xl text-gray-400 mb-12">Wszystko, co musisz wiedzieć o najpopularniejszym darmowym symulatorze lotu. Od konfiguracji wolantu aż po wyduszenie maksymalnej płynności na starszych maszynach. Wszystkie poradniki napisaliśmy sami, na bazie własnych lotów i wsparcia udzielanego na Discordzie.</p>

    <div class="space-y-8">
      {wpisy.map(p => (
        <a href={`/poradniki/${p.slug}/`} class="block p-8 bg-dark-800 rounded-2xl border border-white/5 hover:border-brand-500/40 transition group">
          <div class="flex flex-wrap items-center gap-3 mb-3">
            <span class="px-3 py-1 rounded text-xs font-bold uppercase tracking-widest bg-brand-500/20 text-brand-400">{p.data.poziom}</span>
            <span class="text-gray-500 text-xs uppercase tracking-widest">{p.data.czasCzytania} czytania</span>
          </div>
          <h2 class="text-2xl font-bold text-white mb-3 group-hover:text-brand-400 transition-colors">{p.data.title}</h2>
          <p class="text-gray-400 mb-4">{p.data.description}</p>
          <span class="text-brand-500 font-bold text-sm group-hover:text-brand-400 transition-colors">Czytaj poradnik &rarr;</span>
        </a>
      ))}
    </div>
  </main>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://flightgear-polska.github.io/' },
      { '@type': 'ListItem', position: 2, name: 'Poradniki', item: 'https://flightgear-polska.github.io/poradniki/' },
    ],
  })} />
</Layout>
