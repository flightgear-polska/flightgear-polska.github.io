---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const wpisyRaw = (await getCollection('galerie')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const wpisy = await Promise.all(
  wpisyRaw.map(async (entry) => ({ entry, Content: (await entry.render()).Content }))
);
---
<Layout
  title="Galeria społeczności FlightGear Polska"
  description="Zrzuty ekranu i relacje od pilotów społeczności FlightGear Polska. Pochwal się swoim lotem!"
>
  <main class="container mx-auto px-6 py-20 max-w-4xl">
    <nav aria-label="Okruszki" class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-brand-400 transition-colors">Strona główna</a> / <span class="text-gray-300">Galeria</span>
    </nav>
    <h1 class="text-5xl font-heading font-black text-white mb-8">Galeria <span class="text-brand-500">Społeczności</span></h1>
    <p class="text-xl text-gray-400 mb-6">Relacje i zrzuty ekranu od pilotów FGPL. Każde zaakceptowane zgłoszenie na GitHubie automatycznie trafia tutaj.</p>

    <div class="bg-dark-800 border border-brand-500/30 rounded-2xl p-8 mb-12">
      <h2 class="text-xl font-bold text-white mb-4">Chcesz się tu pojawić?</h2>
      <ol class="text-gray-400 text-sm leading-relaxed space-y-2 list-decimal list-inside mb-6">
        <li>Wrzuć zrzut ekranu (JPG/PNG) do folderu <code class="text-brand-400">public/assets/galeria/</code> w naszym repozytorium.</li>
        <li>W tytule Pull Requesta wpisz tytuł, pod jakim ma się pojawić wpis.</li>
        <li>W opisie PR-a napisz parę zdań o swoim locie.</li>
      </ol>
      <p class="text-gray-500 text-xs mb-6">Po zmergowaniu zgłoszenia wpis pojawia się tutaj automatycznie — nic więcej nie musisz robić.</p>
      <a href="https://github.com/flightgear-polska" target="_blank" rel="noopener noreferrer" class="inline-block bg-brand-500 hover:bg-brand-600 text-dark-950 font-black uppercase tracking-widest px-6 py-3 rounded-lg transition-colors text-sm">Zgłoś swoje zdjęcie na GitHubie</a>
    </div>

    {wpisy.length === 0 ? (
      <p class="text-gray-500 border border-white/10 rounded-xl p-8 text-center">Brak wpisów — bądź pierwszą osobą, która podzieli się swoim lotem!</p>
    ) : (
      <div class="space-y-6">
        {wpisy.map(({ entry, Content }) => (
          <article class="p-8 bg-dark-800 rounded-2xl border border-white/5">
            <h2 class="text-2xl font-bold text-white mb-2">{entry.data.title}</h2>
            <p class="text-gray-500 text-sm mb-4">{entry.data.author} · {entry.data.date.toLocaleDateString('pl-PL')}</p>
            <div class="prose prose-invert max-w-none text-gray-400"><Content /></div>
          </article>
        ))}
      </div>
    )}
  </main>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://flightgear-polska.github.io/' },
      { '@type': 'ListItem', position: 2, name: 'Galeria', item: 'https://flightgear-polska.github.io/galeria/' },
    ],
  })} />
  {wpisy.length > 0 && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      itemListElement: wpisy.map(({ entry }, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: entry.data.title,
      })),
    })} />
  )}
</Layout>
