---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const samoloty = await getCollection('samoloty');
  return samoloty.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const siteUrl = 'https://flightgear-polska.github.io';
const specRows: [string, string][] = [
  ['Załoga', entry.data.specyfikacja.zaloga],
  ['Prędkość przelotowa', entry.data.specyfikacja.predkoscPrzelotowa],
  ['Zasięg', entry.data.specyfikacja.zasieg],
  ['Napęd', entry.data.specyfikacja.silnik],
  ['Poziom trudności', entry.data.specyfikacja.poziomTrudnosci],
];
if (entry.data.statusRozwoju) {
  specRows.push(['Status rozwoju', entry.data.statusRozwoju]);
}
---
<Layout title={`${entry.data.nazwa} we FlightGear | Specyfikacja i pobieranie`} description={entry.data.opisKrotki}>
  <main class="container mx-auto px-6 py-20 max-w-4xl">
    <nav aria-label="Okruszki" class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-brand-400 transition-colors">Strona główna</a> /
      <a href="/samoloty/" class="hover:text-brand-400 transition-colors">Samoloty</a> /
      <span class="text-gray-300">{entry.data.nazwa}</span>
    </nav>

    <span class="inline-block px-3 py-1 rounded text-sm font-bold bg-brand-500/20 text-brand-400 mb-4">{entry.data.tag}</span>
    <h1 class="text-4xl lg:text-5xl font-heading font-black text-white mb-4 leading-tight">{entry.data.nazwa}</h1>
    <p class="text-xl text-gray-400 mb-10">{entry.data.opisKrotki}</p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <div class="bg-dark-800 border border-white/10 rounded-2xl p-6">
        <h2 class="text-sm font-bold uppercase tracking-widest text-gray-500 mb-4">Specyfikacja</h2>
        <ul class="space-y-3">
          {specRows.map(([label, value]) => (
            <li class="flex justify-between gap-4 border-b border-white/5 pb-2 text-sm">
              <span class="text-gray-400">{label}</span>
              <span class="text-white font-bold text-right">{value}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-dark-800 border border-white/10 rounded-2xl p-6 flex flex-col justify-between">
        <div>
          <h2 class="text-sm font-bold uppercase tracking-widest text-gray-500 mb-4">Producent</h2>
          <p class="text-white font-bold mb-1">{entry.data.producent}</p>
          <p class="text-gray-500 text-sm">{entry.data.typ}</p>
        </div>
        <div class="mt-6 space-y-3">
          <a href={entry.data.pobierzUrl} target="_blank" rel="noopener noreferrer" class="block w-full py-3 bg-brand-500 hover:bg-brand-600 text-dark-950 text-center font-black uppercase tracking-widest text-sm rounded-lg transition-colors">
            Pobierz FlightGear
          </a>
          {entry.data.wikiUrl && (
            <a href={entry.data.wikiUrl} target="_blank" rel="noopener noreferrer" class="block w-full py-3 border border-gray-700 hover:border-brand-400 hover:text-brand-400 text-white text-center font-bold uppercase tracking-widest text-sm rounded-lg transition-colors">
              Dokumentacja techniczna
            </a>
          )}
        </div>
      </div>
    </div>

    <article class="prose prose-invert prose-headings:font-heading prose-headings:text-white prose-a:text-brand-400 max-w-none">
      <Content />
    </article>

    <a href="/samoloty/" class="inline-block mt-12 text-gray-400 hover:text-brand-400 transition-colors text-sm">&larr; Wróć do katalogu maszyn</a>
  </main>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: entry.data.nazwa,
    description: entry.data.opisKrotki,
    applicationCategory: 'SimulationApplication',
    operatingSystem: 'Windows, macOS, Linux',
    author: { '@type': 'Organization', name: entry.data.producent },
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  })} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Strona główna', item: `${siteUrl}/` },
      { '@type': 'ListItem', position: 2, name: 'Samoloty', item: `${siteUrl}/samoloty/` },
      { '@type': 'ListItem', position: 3, name: entry.data.nazwa, item: `${siteUrl}/samoloty/${entry.slug}/` },
    ],
  })} />
</Layout>
