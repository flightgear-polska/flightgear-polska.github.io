---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const wydarzenia = await getCollection('wydarzenia');
const posortowane = wydarzenia.sort((a, b) => a.data.typ.localeCompare(b.data.typ));
---
<Layout
  title="Wydarzenia i loty grupowe FlightGear Polska | FGPL"
  description="Cykliczne i jednorazowe loty grupowe organizowane przez społeczność FlightGear Polska na serwerach multiplayer. Dołącz do najbliższego wydarzenia."
>
  <main class="container mx-auto px-6 py-20 max-w-4xl">
    <nav aria-label="Okruszki" class="text-sm text-gray-500 mb-8">
      <a href="/" class="hover:text-brand-400 transition-colors">Strona główna</a> / <span class="text-gray-300">Wydarzenia</span>
    </nav>
    <h1 class="text-5xl font-heading font-black text-white mb-8">Loty <span class="text-brand-500">Grupowe</span></h1>
    <p class="text-xl text-gray-400 mb-12 leading-relaxed">Latanie w grupie to inne doświadczenie niż samotny lot – wspólne starty, formacje i rozmowy na czacie multiplayer. Poniżej zbieramy nasze cykliczne i jednorazowe wydarzenia. Szczegółowe terminy ogłaszamy zawsze na Discordzie.</p>

    <div class="space-y-8">
      {posortowane.map(w => (
        <div class="block p-8 bg-dark-800 rounded-2xl border border-white/5">
          <div class="flex flex-wrap items-center gap-3 mb-3">
            <span class="px-3 py-1 rounded text-xs font-bold uppercase tracking-widest bg-brand-500/20 text-brand-400">{w.data.typ}</span>
            {w.data.serwer && <span class="text-gray-500 text-xs uppercase tracking-widest">{w.data.serwer}</span>}
          </div>
          <h2 class="text-2xl font-bold text-white mb-3">{w.data.title}</h2>
          <p class="text-gray-400 mb-3">{w.data.opisKrotki}</p>
          <p class="text-gray-500 text-sm mb-4"><strong class="text-gray-300">Termin:</strong> {w.data.termin}</p>
          {w.data.link && (
            <a href={w.data.link} target="_blank" rel="noopener noreferrer" class="text-brand-500 font-bold text-sm hover:text-brand-400 transition-colors">Szczegóły i ogłoszenia &rarr;</a>
          )}
        </div>
      ))}
    </div>

    <div class="mt-12 p-6 bg-dark-800 rounded-xl border border-white/5 flex flex-wrap items-center justify-between gap-4">
      <p class="text-gray-400 text-sm">Chcesz zorganizować własny lot grupowy z FGPL?</p>
      <a href="https://discord.gg/5J7uVYRhZV" target="_blank" rel="noopener noreferrer" class="text-brand-500 font-bold text-sm hover:text-brand-400 transition-colors">Zaproponuj na Discordzie &rarr;</a>
    </div>
  </main>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://flightgear-polska.github.io/' },
      { '@type': 'ListItem', position: 2, name: 'Wydarzenia', item: 'https://flightgear-polska.github.io/wydarzenia/' },
    ],
  })} />
</Layout>
