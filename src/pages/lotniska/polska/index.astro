---
import Layout from '../../../layouts/Layout.astro';
import { parse } from 'csv-parse/sync';

const response = await fetch('https://raw.githubusercontent.com/davidmegginson/ourairports-data/main/airports.csv');
const csvData = await response.text();

const records = parse(csvData, {
  columns: true,
  skip_empty_lines: true,
});

const typeLabels: Record<string, string> = {
  large_airport: 'Duże lotnisko',
  medium_airport: 'Średnie lotnisko',
  small_airport: 'Małe lotnisko',
  heliport: 'Lądowisko dla helikopterów',
};

const lotniska = records
  .filter((l: any) => l.iso_country === 'PL' && l.type !== 'closed' && l.ident.length === 4)
  .map((l: any) => ({
    icao: l.ident.toLowerCase(),
    kod: l.ident,
    nazwa: l.name,
    miasto: l.municipality || 'Polska',
    typ: typeLabels[l.type] || l.type,
  }))
  .sort((a: any, b: any) => a.nazwa.localeCompare(b.nazwa, 'pl'));
---
<Layout
  title={`Lotniska w Polsce dla FlightGear – ${lotniska.length} lokalizacji do pobrania`}
  description={`Pełna lista ${lotniska.length} polskich lotnisk dostępnych we FlightGear – dane nawigacyjne ICAO, współrzędne GPS i linki do pobrania symulatora. Wyszukaj po nazwie, mieście lub kodzie ICAO.`}
>
  <header class="bg-dark-800 border-b border-white/5 py-20 relative overflow-hidden">
    <div class="absolute top-0 right-0 w-1/2 h-full bg-brand-500/10 blur-[100px]"></div>
    <div class="container mx-auto px-6 relative z-10">
      <nav aria-label="Okruszki" class="text-sm text-gray-500 mb-4">
        <a href="/" class="hover:text-brand-400 transition-colors">Strona główna</a> / <span class="text-gray-300">Lotniska w Polsce</span>
      </nav>
      <h1 class="text-4xl lg:text-5xl font-heading font-bold text-white mb-4">
        Polskie lotniska we <span class="text-brand-400">FlightGear</span>
      </h1>
      <p class="text-xl text-gray-400">{lotniska.length} lotnisk i lądowisk gotowych do startu w darmowym symulatorze lotu.</p>

      <div class="mt-8 max-w-md relative">
        <input
          type="text"
          id="airport-search"
          placeholder="Szukaj po nazwie, mieście lub kodzie ICAO…"
          autocomplete="off"
          class="w-full bg-dark-950/80 border border-white/15 rounded-lg px-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-transparent"
        />
        <p id="airport-search-count" class="mt-2 text-xs text-gray-500 uppercase tracking-widest"></p>
      </div>
    </div>
  </header>

  <main class="container mx-auto px-6 py-16">
    <div id="airport-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {lotniska.map((l: any) => (
        <a
          href={`/lotniska/polska/${l.icao}/`}
          class="airport-card block bg-white/5 border border-white/10 rounded-xl p-5 hover:border-brand-500 hover:bg-white/10 transition"
          data-search={`${l.nazwa} ${l.miasto} ${l.kod}`.toLowerCase()}
        >
          <div class="flex justify-between items-start gap-2 mb-2">
            <h2 class="font-bold text-white leading-snug">{l.nazwa}</h2>
            <span class="font-mono text-brand-400 text-sm shrink-0">{l.kod}</span>
          </div>
          <p class="text-gray-500 text-sm">{l.miasto} · {l.typ}</p>
        </a>
      ))}
    </div>
    <p id="airport-empty" class="hidden text-center text-gray-500 py-16">Brak lotnisk pasujących do wyszukiwania. Spróbuj innej frazy.</p>
  </main>

  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://flightgear-polska.github.io/' },
      { '@type': 'ListItem', position: 2, name: 'Lotniska', item: 'https://flightgear-polska.github.io/lotniska/polska/' },
    ],
  })} />

  <script>
    const input = document.getElementById('airport-search') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.airport-card'));
    const empty = document.getElementById('airport-empty');
    const count = document.getElementById('airport-search-count');

    function applyFilter() {
      const q = (input?.value || '').trim().toLowerCase();
      let visible = 0;
      cards.forEach((card) => {
        const match = !q || (card.dataset.search || '').includes(q);
        card.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      if (empty) empty.classList.toggle('hidden', visible !== 0);
      if (count) count.textContent = q ? `Znaleziono: ${visible}` : '';
    }

    input?.addEventListener('input', applyFilter);

    // Pozwala linkować bezpośrednio z wyszukiwarki strony (?q=...) lub schema.org SearchAction
    const params = new URLSearchParams(window.location.search);
    const initial = params.get('q');
    if (initial && input) {
      input.value = initial;
      applyFilter();
    }
  </script>
</Layout>
