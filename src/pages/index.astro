---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import heroImage from '../assets/fgpl4sst005.png';
import boeingImage from '../assets/fgpl4sst001.png';
import koliberImage from '../assets/Listopad_2023.png';

const discordInvite = 'https://discord.gg/5J7uVYRhZV';

const faq = [
  {
    q: 'Czy FlightGear jest naprawdę darmowy?',
    a: 'Tak. FlightGear to w 100% darmowy i otwartoźródłowy symulator lotu, rozwijany od 1997 roku. Nie ma mikropłatności ani płatnych dodatków.',
  },
  {
    q: 'Czym jest FlightGear Polska?',
    a: 'Jesteśmy społecznością polskich pasjonatów FlightGeara – tworzymy sceneria polskich lotnisk, modyfikujemy samoloty, organizujemy wspólne loty i pokazy lotnicze oraz piszemy poradniki dla początkujących.',
  },
  {
    q: 'Jak dołączyć do społeczności?',
    a: 'Najszybciej przez nasz serwer Discord, gdzie organizujemy wspólne loty i wydarzenia. Kod źródłowy naszych projektów znajdziesz na GitHubie.',
  },
  {
    q: 'Czym są addony i czy są obowiązkowe?',
    a: 'Addony to dodatkowe, niezależne rozszerzenia tworzone przez społeczność – np. dziennik lotów, mówione ATC czy integracja z mapami nawigacyjnymi. Nie są wymagane do latania, ale mocno poszerzają możliwości symulatora. Zobacz nasz katalog addonów.',
  },
];
---
<Layout
  title="FlightGear Polska – Portal Informacyjny Polskiej Społeczności Symulatora Lotu"
  description="Oficjalny portal FlightGear Polska. Darmowy symulator lotu, polskie sceneria lotnisk, samoloty, poradniki i pokazy lotnicze. Dołącz do społeczności wirtualnego lotnictwa."
>

  <main class="bg-dark-900 text-white min-h-screen font-sans">

    <!-- BRANDING & NEWS HERO -->
    <section class="relative pt-24 pb-16 bg-dark-950 overflow-hidden border-b border-gray-900">
      <div class="absolute inset-0 opacity-20">
        <Image src={heroImage} alt="" role="presentation" class="w-full h-full object-cover blur-sm" loading="eager" fetchpriority="high" widths={[640, 1280, 1920]} sizes="100vw" quality={75} />
        <div class="absolute inset-0 bg-gradient-to-r from-dark-950 via-dark-950/80 to-transparent"></div>
      </div>

      <div class="container mx-auto px-6 relative z-10 flex flex-col md:flex-row gap-12 items-center">
        <div class="flex-1">
          <h1 class="text-5xl md:text-7xl lg:text-8xl font-black uppercase text-white mb-6 tracking-tighter">
            FlightGear Polska
          </h1>
          <p class="text-xl text-gray-300 font-medium mb-8 max-w-2xl leading-relaxed">
            Oficjalny hub polskiego lotnictwa wirtualnego. Darmowy symulator lotu, polskie sceneria, realistyczne samoloty i społeczność pasjonatów nieba.
          </p>
          <div class="flex flex-wrap gap-4">
            <a href="https://www.flightgear.org/download/" target="_blank" rel="noopener noreferrer" class="inline-block bg-brand-500 hover:bg-brand-600 text-dark-950 font-black uppercase tracking-widest px-8 py-4 rounded-lg transition-colors">
              Pobierz FlightGear za darmo
            </a>
            <a href={discordInvite} target="_blank" rel="noopener noreferrer" class="inline-block bg-[#5865F2] hover:bg-[#4752c4] text-white font-black uppercase tracking-widest px-8 py-4 rounded-lg transition-colors">
              Dołącz do Discorda
            </a>
            <a href="/lotniska/polska/" class="inline-block border border-gray-700 hover:border-brand-400 hover:text-brand-400 text-white font-bold uppercase tracking-widest px-8 py-4 rounded-lg transition-colors">
              Zobacz polskie lotniska
            </a>
          </div>
        </div>

        <div class="flex-1 w-full max-w-md bg-black/60 backdrop-blur-md border border-gray-800 p-8 rounded-xl shadow-2xl" id="news">
          <h2 class="text-xl font-black uppercase text-brand-500 mb-8 flex items-center gap-3">
             <span class="w-2 h-2 bg-brand-500 rounded-full animate-pulse"></span> News Feed
          </h2>
          <div class="space-y-6">
            <a href="#video-center" class="block group">
              <span class="text-xs text-gray-500 font-bold uppercase tracking-widest block mb-1">Wydarzenia</span>
              <h3 class="text-lg font-bold text-white group-hover:text-brand-400 transition-colors">FGPL 4th Anniversary Airshow – replay. Zobacz zapis!</h3>
            </a>
            <hr class="border-gray-800" />
            <a href="/lotniska/polska/" class="block group">
              <span class="text-xs text-gray-500 font-bold uppercase tracking-widest block mb-1">Sceneria VFR</span>
              <h3 class="text-lg font-bold text-white group-hover:text-brand-400 transition-colors">Katalog polskich lotnisk – sprawdź, które już ogarnęliśmy.</h3>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- CENTERPIECE (MULTIMEDIA & UPDATES) -->
    <section id="video-center" class="py-24 container mx-auto px-6">
      <div class="max-w-6xl mx-auto flex flex-col lg:flex-row gap-12 items-start">

        <div class="flex-1 w-full flex-grow">
          <h2 class="text-3xl font-black uppercase text-white mb-8 border-l-4 border-brand-500 pl-4">Multimedia</h2>
          <div class="aspect-video rounded-xl overflow-hidden shadow-2xl border border-gray-800 bg-black relative w-full">
            <iframe
              class="w-full h-full absolute inset-0"
              src="https://www.youtube.com/embed/JCN0kWJp4lw?rel=0"
              title="FlightGear Polska 4th Anniversary Airshow – Dzień 1 (REPLAY)"
              loading="lazy"
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen>
            </iframe>
          </div>
        </div>

        <div class="flex-1 w-full lg:max-w-md">
          <h2 class="text-3xl font-black uppercase text-white mb-8 border-l-4 border-gray-700 pl-4">Ostatnie Aktualizacje</h2>
          <div class="space-y-6">
            <article class="bg-dark-950 p-6 rounded-lg border border-gray-800 hover:border-gray-600 transition-colors">
              <h3 class="text-xl font-bold text-brand-400 mb-2">Wirtualne linie lotnicze w naszej ekipie</h3>
              <p class="text-gray-400 text-sm leading-relaxed">Część naszych pilotów lata też w barwach wirtualnych linii takich jak Parrott Airlines czy Performance Airlines, a wielu z nas działa jako kontrolerzy i piloci na sieciach VATSIM oraz IVAO.</p>
            </article>
            <article class="bg-dark-950 p-6 rounded-lg border border-gray-800 hover:border-gray-600 transition-colors">
              <h3 class="text-xl font-bold text-brand-400 mb-2">PZL Koliber 150 do pobrania</h3>
              <p class="text-gray-400 text-sm leading-relaxed">Nasz rodzimy projekt – model PZL Koliber 150 – jest w pełni darmowy i otwarty. Zajrzyj na GitHuba, jeśli chcesz zgłosić błąd albo dorzucić swój wkład.</p>
            </article>
          </div>
        </div>

      </div>
    </section>

    <!-- INFORMATION ARCHITECTURE: KIM JESTEŚMY -->
    <section class="py-24 bg-dark-950 border-y border-gray-900 relative">
      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-5xl mx-auto text-center">
          <h2 class="text-4xl font-black uppercase text-white mb-16">Ekipa pasjonatów nieba</h2>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-12 text-left">
            <div>
              <h3 class="text-xl font-bold text-white mb-4 border-b border-gray-800 pb-2">Otwarte Lotnictwo</h3>
              <p class="text-gray-400 text-sm leading-relaxed">Nie jesteśmy korporacją, nie sprzedajemy dodatków. Ekipa FGPL to grupa zapaleńców, która od lat rozwija wirtualne lotnictwo bez paywalla, w duchu otwartego oprogramowania.</p>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-4 border-b border-gray-800 pb-2">Technika i Realizm</h3>
              <p class="text-gray-400 text-sm leading-relaxed">Wspólnie pracujemy nad silnikiem JSBSim. Doszlifowujemy maszyny aż po ostatni nit, tak by podejście z wiatrem bocznym zachowało maksymalny realizm w odczuciu z kokpitu.</p>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white mb-4 border-b border-gray-800 pb-2">Dzielenie Się Pasją</h3>
              <p class="text-gray-400 text-sm leading-relaxed">Organizujemy wydarzenia, piszemy poradniki i szkolimy nowych pilotów z procedur Cold &amp; Dark. Lataj z nami i przekaż to dalej.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- FLIGHT MAGAZINE: FLEET -->
    <section id="flota" class="py-24 container mx-auto px-6">
      <h2 class="text-4xl font-black uppercase text-center text-white mb-20">Maszyny, o których mówimy</h2>

      <div class="flex flex-col gap-24 max-w-5xl mx-auto">
        <article class="flex flex-col md:flex-row gap-12 items-center">
          <div class="w-full md:w-1/2 rounded-2xl overflow-hidden shadow-2xl border border-gray-800 relative bg-black aspect-[4/3]">
            <Image src={boeingImage} alt="Zrzut ekranu z lotu Boeingiem 737-800 we FlightGear" class="absolute inset-0 w-full h-full object-cover" loading="lazy" width={800} height={600} quality={80} />
          </div>
          <div class="w-full md:w-1/2">
            <span class="text-brand-500 font-bold uppercase tracking-widest text-xs mb-3 block">Legenda Lotnictwa Pasażerskiego</span>
            <h3 class="text-3xl font-black text-white mb-6 uppercase">Boeing 737-800</h3>
            <p class="text-gray-400 text-base leading-relaxed mb-8">
              Ten model to klasyk FlightGeara. Fantastycznie omodelowany komputer LNAV/VNAV i w pełni klikalny kokpit sprawiają, że podejście w zamieci śnieżnej na warszawskim Okęciu daje ogromną satysfakcję. Każde przełączenie hydrauliki jest tu słyszalne i odczuwalne.
            </p>
            <a href="/samoloty/boeing-737-800/" class="text-white font-bold uppercase tracking-widest border-b border-white hover:text-brand-400 hover:border-brand-400 transition-colors">
              Zobacz pełną specyfikację &rarr;
            </a>
          </div>
        </article>

        <article class="flex flex-col md:flex-row-reverse gap-12 items-center">
          <div class="w-full md:w-1/2 rounded-2xl overflow-hidden shadow-2xl border border-gray-800 relative bg-black aspect-[4/3]">
            <Image src={koliberImage} alt="Lot nad Polską samolotem PZL Koliber" class="absolute inset-0 w-full h-full object-cover" loading="lazy" width={800} height={600} quality={80} />
          </div>
          <div class="w-full md:w-1/2">
            <span class="text-brand-500 font-bold uppercase tracking-widest text-xs mb-3 block">Rodzimy Projekt FGPL</span>
            <h3 class="text-3xl font-black text-white mb-6 uppercase">PZL Koliber 150</h3>
            <p class="text-gray-400 text-base leading-relaxed mb-8">
              Prawdziwa duma polskiego warsztatu symulacyjnego. Niezastąpiona maszyna do powolnego VFR nad aeroklubami i poznawania procedur awaryjnych. Skrupulatnie testowaliśmy drgania na wolancie – ta niepozorna awionetka stała się ikoną precyzyjnego latania po obrzeżach.
            </p>
            <a href="/samoloty/pzl-koliber-150/" class="text-white font-bold uppercase tracking-widest border-b border-white hover:text-brand-400 hover:border-brand-400 transition-colors">
              Pobierz projekt i polataj &rarr;
            </a>
          </div>
        </article>
      </div>
    </section>

    <!-- ADDONY & WYDARZENIA -->
    <section class="py-24 bg-dark-950 border-t border-gray-900">
      <div class="container mx-auto px-6 max-w-5xl">
        <h2 class="text-4xl font-black uppercase text-center text-white mb-4">Więcej niż samolot</h2>
        <p class="text-gray-400 text-center max-w-2xl mx-auto mb-16">FlightGear to coś więcej niż katalog maszyn – addony społeczności, wspólne loty i stale poprawiana sceneria robią największą różnicę w codziennym lataniu.</p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <a href="/addony/" class="group block bg-dark-800 border border-white/10 rounded-2xl p-8 hover:border-brand-500 transition">
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-brand-400 transition-colors">Addony</h3>
            <p class="text-gray-400 text-sm mb-6">Dziennik lotów, mówione ATC, integracja z LittleNavMap i kilkanaście innych narzędzi rozszerzających symulator.</p>
            <span class="text-brand-500 font-bold text-sm group-hover:text-brand-400 transition-colors">Zobacz katalog &rarr;</span>
          </a>
          <a href="/wydarzenia/" class="group block bg-dark-800 border border-white/10 rounded-2xl p-8 hover:border-brand-500 transition">
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-brand-400 transition-colors">Wydarzenia</h3>
            <p class="text-gray-400 text-sm mb-6">Cotygodniowe loty grupowe i jednorazowe eventy organizowane przez społeczność FGPL na serwerach multiplayer.</p>
            <span class="text-brand-500 font-bold text-sm group-hover:text-brand-400 transition-colors">Dołącz do lotu &rarr;</span>
          </a>
          <a href="/poradniki/" class="group block bg-dark-800 border border-white/10 rounded-2xl p-8 hover:border-brand-500 transition">
            <h3 class="text-xl font-bold text-white mb-3 group-hover:text-brand-400 transition-colors">Poradniki</h3>
            <p class="text-gray-400 text-sm mb-6">Od pierwszego lotu Cold &amp; Dark po konfigurację multiplayer, instalację addonów i TerraSync.</p>
            <span class="text-brand-500 font-bold text-sm group-hover:text-brand-400 transition-colors">Czytaj poradniki &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="py-24 bg-dark-950 border-t border-gray-900">
      <div class="container mx-auto px-6 max-w-3xl">
        <h2 class="text-4xl font-black uppercase text-center text-white mb-16">Najczęstsze pytania</h2>
        <div class="space-y-4">
          {faq.map(item => (
            <details class="group bg-dark-900 border border-gray-800 rounded-lg p-6 open:border-brand-500/50">
              <summary class="font-bold text-white cursor-pointer list-none flex justify-between items-center gap-4">
                {item.q}
                <span class="text-brand-500 text-xl group-open:rotate-45 transition-transform">+</span>
              </summary>
              <p class="text-gray-400 mt-4 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

  </main>

  <link rel="preload" as="image" href={heroImage.src} slot="head" />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(item => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  })} />
</Layout>
